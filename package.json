{
  "name": "benzo",
  "version": "0.1.0",
  "description": "Reusable named development servers for Git worktrees",
  "type": "module",
  "bin": {
    "benzo": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "import": "./dist/core.js",
      "default": "./dist/core.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "docs/auth-compatibility.md",
    "docs/environment-api.md",
    "docs/portless-adapter.md",
    "docs/roadmap-checklist.md",
    "docs/https.md",
    "docs/compatibility-plan.md",
    "compatibility/README.md",
    "compatibility/reports"
  ],
  "scripts": {
    "test": "node --test test/core.test.js test/auth.test.js test/runtime.test.js .test-dist/test/better-auth.test.js test/acceptance.test.js .test-dist/test/streaming.test.js .test-dist/test/portless-plan.test.js test/tls.test.js .test-dist/test/test-watch.test.js",
    "test:watch": "node .tools-dist/scripts/test-watch.js",
    "test:browser": "node --test test/browser/auth.test.js test/browser/frameworks.test.js test/browser/tls.test.js test/browser/form-post.test.js",
    "test:soak": "node --test test/lifecycle-soak.test.js",
    "test:compat": "node compatibility/run.mjs",
    "lab:clients": "node --test compatibility/lab/clients.test.js",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "pretest": "npm run test:types && npm run build:tests",
    "prepack": "npm run build",
    "pretest:browser": "npm run build",
    "pretest:soak": "npm run build",
    "pretest:compat": "npm run build",
    "prelab:clients": "npm run build",
    "pretest:watch": "tsc -p tsconfig.tools.json",
    "prepare": "npm run build",
    "test:types": "npm run build && tsc -p tsconfig.consumer.json",
    "build:tests": "tsc -p tsconfig.tests.json"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "license": "MIT",
  "dependencies": {
    "cross-spawn": "^7.0.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/bun": "^1.4.4",
    "@types/cross-spawn": "^6.0.6",
    "@types/node": "^26.6.6",
    "better-auth": "^1.7.14",
    "next": "^16.4.3",
    "prettier": "^3.9.10",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
